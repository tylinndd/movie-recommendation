# --- Render (backend) ---
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated origins, no trailing slash (production + Vercel previews)
FRONTEND_URL=https://your-app.vercel.app
# Optional: allow all Vercel preview URLs (regex)
FRONTEND_ORIGIN_REGEX=^https://[\w-]+\.vercel\.app$
DATABASE_URL=postgresql://...

# --- Vercel (frontend build) ---
# Public Render API URL, no trailing slash
API_URL=https://filmfanatic.onrender.com
